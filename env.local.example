# Next.js Environment Variables (Frontend)
# Copia este archivo a .env.local y reemplaza los valores

# Google reCAPTCHA v2
# Obtén tu Site Key en: https://www.google.com/recaptcha/admin/create
# IMPORTANTE: Esta clave es pública y será visible en el navegador
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=tu_site_key_aqui

